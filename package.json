{
    "name": "@recombine-ai/engine",
    "version": "0.11.1",
    "description": "Recombine AI engine for creating conversational AI agents",
    "repository": {
        "url": "git+https://github.com/recombine-ai/engine.git"
    },
    "main": "build/index.js",
    "types": "build/index.d.ts",
    "author": "Recombine AI limited",
    "license": "MIT",
    "private": false,
    "scripts": {
        "dev": "tsc -w",
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run build",
        "test": "vitest",
        "docs": "cd docusaurus && npm run build --out-dir ../docs && cd ..",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky",
        "precommit-hook": "lint-staged"
    },
    "devDependencies": {
        "@eslint/js": "^9.26.0",
        "@types/node": "^22.8.1",
        "@types/nunjucks": "^3.2.6",
        "@typescript-eslint/eslint-plugin": "^8.32.0",
        "eslint": "^9.26.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.4",
        "prettier": "^3.3.3",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.32.0",
        "vitest": "^3.0.6"
    },
    "dependencies": {
        "nunjucks": "^3.2.4",
        "openai": "6.8.1",
        "zod": "3.23.8",
        "zod-to-json-schema": "3.24.6"
    },
    "husky": {
        "hooks": {}
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx,json,md}": [
            "npm run format",
            "npm run lint:fix"
        ]
    }
}
