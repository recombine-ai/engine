{
    "compilerOptions": {
        "declaration": true,
        "declarationMap": true,
        "target": "ES2022",
        "module": "CommonJS",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "outDir": "./build",
        "noImplicitAny": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "strictBindCallApply": true,
        "strictPropertyInitialization": true,
        "noImplicitThis": true,
        "alwaysStrict": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "build", "src/**/*.spec.ts"]
}
